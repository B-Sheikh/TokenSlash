{
  "name": "tokenslash-server",
  "version": "1.0.0",
  "description": "TokenSlash MCP Server Tools - Model Recommender & History Analyzer with Satisfaction ML Model",
  "main": "packages/server/dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "cmd /c \"cd packages/server && npx tsx src/main.ts\"",
    "start": "cmd /c \"cd packages/server && node dist/main.js\"",
    "build": "cmd /c \"cd packages/server && npm run build\"",
    "test": "cmd /c \"cd packages/server && npm test\"",
    "train:ml": "python packages/server/src/ml/train_satisfaction.py",
    "start:server": "cmd /c \"cd packages/server && npx tsx src/api_server.ts\""
  },
  "dependencies": {
    "@nitrostack/core": "^1.0.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
